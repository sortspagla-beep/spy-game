rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Global Chat collection
    match /global_chat/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) &&
        incoming().content is string && incoming().content.size() > 0 && incoming().content.size() <= 1000 &&
        incoming().senderUsername is string && incoming().senderUsername.size() <= 50;
      allow update, delete: if request.auth != null && request.auth.token.email == 'obyda.cmch@gmail.com';
    }

    // Profiles collection
    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'obyda.cmch@gmail.com'
      );
    }

    // Rooms collection
    match /rooms/{roomCode} {
      allow read: if true;
      allow write: if false;
    }
  }
}
